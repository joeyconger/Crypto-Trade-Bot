# ---- Solana execution ----
# RPC endpoint the bot uses to read chain state and submit swap transactions.
# A dedicated RPC (e.g. Helius) is strongly recommended over public endpoints.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base58-encoded secret key for the bot's OWN keypair (not your Phantom wallet).
# Generate one with `solana-keygen new` or the bot's own keygen script, then
# fund that public key manually by sending SOL from Phantom. Never put your
# personal wallet's private key here.
BOT_PRIVATE_KEY=

# ---- Live trading safety gate (both required to place real transactions) ----
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=false

# ---- Data providers ----
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# ---- Social signal (optional; falls back to disabled if unset) ----
TWITTER_BEARER_TOKEN=

# ---- Storage ----
DATABASE_PATH=./data/bot.sqlite

# ---- Watchlist config ----
WATCHLIST_CONFIG_PATH=./config/watchlist.yaml

# ---- Dashboard ----
DASHBOARD_PORT=4000

# ---- Paper trading ----
PAPER_STARTING_BALANCE_USD=1000
POLL_INTERVAL_SECONDS=300
