# ---- Solana execution ----
# RPC endpoint the bot uses to read chain state and submit swap transactions.
# A dedicated RPC (e.g. Helius) is strongly recommended over public endpoints.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Secret key for the bot's OWN keypair (not your Phantom wallet). Only needed
# for tail live trading (see TAIL_LIVE_TRADING below). Run
# `npm run generate-keypair` to create one -- it prints a public address to
# fund from Phantom and a base58 secret to paste here. Accepts either that
# base58 string or a raw JSON byte-array (e.g. solana-keygen's id.json
# contents). Never put your personal wallet's private key here, and never
# share/commit this value once set.
BOT_PRIVATE_KEY=

# ---- Data providers ----
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# Which provider serves current price/market cap. "geckoterminal" is the
# default. Switch to "birdeye" (and set BIRDEYE_API_KEY above) once you have
# a plan with quota available. See README's data provider section for the
# tradeoffs.
PRICE_PROVIDER=geckoterminal

# REQUIRED when PRICE_PROVIDER=geckoterminal (the default) -- without this,
# every price/OHLCV lookup fails with a 401 (CoinGecko's keyed onchain API
# host, unlike the old public GeckoTerminal API, rejects anonymous requests
# outright rather than just rate-limiting them). A free CoinGecko "Demo" API
# key (NOT a paid plan -- no cost, no credit card, just a signup). Get one at
# https://www.coingecko.com/en/api/pricing ("Demo" tier) and paste it here.
GECKOTERMINAL_API_KEY=

# ---- Storage ----
DATABASE_PATH=./data/bot.sqlite

# ---- Dashboard ----
DASHBOARD_PORT=4000

# ---- Wallet-tail module (src/tail/) ----
# Mirrors specific wallet(s)' on-chain swaps -- paper by default, real
# execution once TAIL_LIVE_TRADING is turned on below. See README's
# "Wallet tail" section for full setup (a Helius webhook needs to be
# registered manually in your Helius account -- this can't be done for you).
TAIL_ENABLED=false
# Comma-separated wallet address(es) to mirror -- seeds the initial DB row(s)
# on first startup; add/remove more later from the dashboard without a
# redeploy.
TAIL_WALLET_ADDRESSES=HxwmEH84o3EuezCUZuBEEeKT6uMDv8R4VRi76ExB87St
# Comma-separated display labels, index-aligned with TAIL_WALLET_ADDRESSES
# (e.g. "omo,Sling"). Purely cosmetic -- optional.
TAIL_WALLET_LABELS=
TAIL_POSITION_SIZE_PCT=2
# Paper mode only -- simulates route-building + tx + confirmation lag before
# pricing the fill. Live mode executes as fast as possible instead.
TAIL_SIMULATED_DELAY_SECONDS=5
TAIL_STARTING_BALANCE_USD=1000
# If the token's current price at detection time is already this much %
# above the tailed wallet's own entry price, the buy is skipped entirely --
# no position opened, live or paper. Applies to both modes.
TAIL_MAX_ENTRY_SLIPPAGE_PCT=15
# Set this to any random string, then use the SAME value as the
# "Authorization Header" value when creating the Helius webhook -- otherwise
# the webhook endpoint accepts unauthenticated POSTs from anyone who finds it.
TAIL_WEBHOOK_SECRET=
# Optional: your Helius webhook's ID (the last segment of its URL). Lets the
# dashboard's add/remove-wallet actions keep that webhook's watched-address
# list in sync automatically. Without it, update the webhook manually.
TAIL_HELIUS_WEBHOOK_ID=

# ---- Wallet-tail LIVE trading -- REAL funds, REAL swaps, no per-trade
# approval step. Both flags below must be explicitly "true" AND
# BOT_PRIVATE_KEY must be set, or tail stays paper-only. See README's
# "Going live" subsection before flipping these. ----
TAIL_LIVE_TRADING=false
TAIL_LIVE_TRADING_CONFIRM=false
# Jupiter swap slippage tolerance, in basis points (100 = 1%).
TAIL_LIVE_SLIPPAGE_BPS=100
# If the live wallet's USD balance drops more than this % from its value at
# the start of the current UTC day, new live buys pause until the next UTC
# day. Existing open positions still sell normally -- this only blocks new
# entries, it's not a per-trade stop-loss.
TAIL_LIVE_DAILY_LOSS_LIMIT_PCT=20
# Kill switch for the daily loss cap above. Defaults to enabled (anything
# other than the literal "false" leaves it on). Set to "false" to stop new
# live buys from pausing on drawdown; set back to "true" (or delete this
# line) to re-arm it.
TAIL_LIVE_DAILY_LOSS_CAP_ENABLED=true
