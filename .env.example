# ---- Solana execution ----
# RPC endpoint the bot uses to read chain state and submit swap transactions.
# A dedicated RPC (e.g. Helius) is strongly recommended over public endpoints.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Secret key for the bot's OWN keypair (not your Phantom wallet). Run
# `npm run generate-keypair` to create one -- it prints a public address to
# fund from Phantom and a base58 secret to paste here. Accepts either that
# base58 string or a raw JSON byte-array (e.g. solana-keygen's id.json
# contents). Never put your personal wallet's private key here, and never
# share/commit this value once set.
BOT_PRIVATE_KEY=

# ---- Live trading safety gate (both required to place real transactions) ----
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=false

# ---- Data providers ----
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# Which provider serves OHLCV candles + price + the top-traded token list.
# "geckoterminal" is the default -- it's free and needs no API key/signup,
# so a fresh deploy works even before BIRDEYE_API_KEY is set, and it's the
# fallback for when Birdeye's quota runs out. Switch to "birdeye" (and set
# BIRDEYE_API_KEY above) once you have a plan with quota available -- it's
# the more thoroughly exercised of the two. See README's data provider
# section for the tradeoffs.
PRICE_PROVIDER=geckoterminal

# Strongly recommended when PRICE_PROVIDER=geckoterminal. A fully anonymous
# request shares GeckoTerminal's rate limit with every other unauthenticated
# caller worldwide, not just this bot. A free CoinGecko "Demo" API key (NOT
# a paid plan -- no cost, no credit card, just a signup) gets a dedicated
# allowance instead. Get one at https://www.coingecko.com/en/api/pricing
# ("Demo" tier) and paste it here.
GECKOTERMINAL_API_KEY=

# ---- Social signal (optional; falls back to disabled if unset) ----
TWITTER_BEARER_TOKEN=

# ---- Storage ----
DATABASE_PATH=./data/bot.sqlite

# ---- Watchlist config ----
WATCHLIST_CONFIG_PATH=./config/watchlist.yaml

# ---- Dashboard ----
DASHBOARD_PORT=4000

# ---- Paper trading ----
PAPER_STARTING_BALANCE_USD=1000
POLL_INTERVAL_SECONDS=300

# ---- Wallet-tail research module (src/tail/) ----
# Fully separate paper-trading experiment that mirrors a specific wallet's
# swaps to test whether copy-tailing it is viable. Its own paper balance, own
# DB tables, paper-only -- no live path exists for this module at all. See
# README's "Wallet tail" section for full setup (a Helius webhook needs to be
# registered manually in your Helius account -- this can't be done for you).
TAIL_ENABLED=false
# Comma-separated wallet address(es) to mirror.
TAIL_WALLET_ADDRESSES=HxwmEH84o3EuezCUZuBEEeKT6uMDv8R4VRi76ExB87St
TAIL_POSITION_SIZE_PCT=2
TAIL_SIMULATED_DELAY_SECONDS=5
TAIL_STARTING_BALANCE_USD=1000
# Set this to any random string, then use the SAME value as the
# "Authorization Header" value when creating the Helius webhook -- otherwise
# the webhook endpoint accepts unauthenticated POSTs from anyone who finds it.
TAIL_WEBHOOK_SECRET=
