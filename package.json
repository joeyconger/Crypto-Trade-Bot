{
  "name": "vibes-and-fibs",
  "version": "0.1.0",
  "private": true,
  "description": "Wallet-tail Solana trading bot -- mirrors specific wallets' swaps, paper by default with an optional live-trading mode.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "generate-keypair": "tsx src/scripts/generate-keypair.ts",
    "tail-summary": "tsx src/scripts/tailSummary.ts",
    "wallet-cluster": "tsx src/scripts/walletCluster.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "better-sqlite3": "^11.3.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
